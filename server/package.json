{
  "name": "cr-server",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "start:web": "tsx src/index.ts --serve-web",
    "start:agent": "tsx src/index.ts --agent",
    "doctor": "tsx src/doctor.ts --cli"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@xterm/headless": "5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
